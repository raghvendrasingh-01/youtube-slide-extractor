# Copy to backend/.env when running locally.
FRAMENOTES_JOBS_DIR=./data/jobs
FRAMENOTES_AUTHORIZED_ROOTS=./media
FRAMENOTES_DEFAULT_INTERVAL=5
FRAMENOTES_DEFAULT_START_TIME=0
FRAMENOTES_DEFAULT_MAX_FRAMES=500
FRAMENOTES_WORKER_POLL_SECONDS=0.2
FRAMENOTES_SOURCE_DOWNLOAD_TIMEOUT=900
FRAMENOTES_PLAYLIST_MAX_ITEMS=30
FRAMENOTES_MAX_CONCURRENT_JOBS=2
FRAMENOTES_DELETE_WAIT_SECONDS=10
FRAMENOTES_MAX_JOB_SECONDS=3600
FRAMENOTES_MAX_VIDEO_SECONDS=14400
FRAMENOTES_MAX_SOURCE_BYTES=1073741824
FRAMENOTES_MAX_JOB_BYTES=2147483648
FRAMENOTES_MAX_TOTAL_FRAMES=6000
FRAMENOTES_MAX_QUEUED_JOBS=8
FRAMENOTES_RETENTION_HOURS=24
FRAMENOTES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRAMENOTES_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FRAMENOTES_SECURE_COOKIES=false
# Set a long random value in shared deployments; local mode persists a random
# secret at FRAMENOTES_JOBS_DIR/.session_secret when this is blank.
# FRAMENOTES_SESSION_SECRET=
FRAMENOTES_MAX_REQUEST_BODY_BYTES=2097152
FRAMENOTES_MAX_SESSION_EXPENSIVE_REQUESTS=30
FRAMENOTES_SESSION_RATE_WINDOW_SECONDS=60
FRAMENOTES_MAX_SESSION_JOBS=32
FRAMENOTES_MAX_STORED_JOBS=128
FRAMENOTES_MAX_STORAGE_BYTES=8589934592
FRAMENOTES_UPLOAD_TIMEOUT_SECONDS=900
FRAMENOTES_MAX_CONCURRENT_EXPORTS=1
FRAMENOTES_MAX_QUEUED_EXPORTS=4
FRAMENOTES_MAX_EXPORTS_PER_JOB=8
FRAMENOTES_MAX_EXPORT_BYTES=1073741824
FRAMENOTES_CLEANUP_INTERVAL_SECONDS=300
FRAMENOTES_SHUTDOWN_WAIT_SECONDS=20
